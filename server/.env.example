PORT=8787
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
CACHE_KEY=hi-vision:cameras:v1

# WebRTC TURN — WAJIB di production biar video tidak hitam di balik NAT
# Contoh coturn di host yang sama (lihat docs/DEPLOY.md)
# TURN_URLS=turn:cctv.example.com:3478,turn:cctv.example.com:3478?transport=tcp
# TURN_USERNAME=hivision
# TURN_CREDENTIAL=ganti-password-kuat
